# Copy only the values you need into a private .env file:
# (umask 077; touch .env); chmod 600 .env

# ── Application defaults ───────────────────────────────────────────────────
# STRIDE_BACKEND=vllm             # vllm, omlx (mlx alias), or explicit openai
# STRIDE_DEVICE=cuda              # cuda on Spark, mps on Apple, cpu elsewhere
# STRIDE_CONCURRENCY=2             # Spark is deliberately bounded to 2
# STRIDE_CONTEXT_SIZE=32768
# STRIDE_MAX_TOKENS=32768
# STRIDE_ENABLE_THINKING=0
# STRIDE_REASONING_STRENGTH=high  # Muse Glimmer budgets: low, medium, high, xhigh
# STRIDE_METRICS_PORT=9108       # optional Prometheus endpoint for threat-model runs
# LLM_TIMEOUT=120
# NVD_API_KEY=                    # optional; higher NVD API rate limits for intel update-nvd

# ── NVIDIA DGX Spark / vLLM ────────────────────────────────────────────────
HF_TOKEN=hf_replace_me
HF_HUB_DISABLE_XET=1
VLLM_IMAGE=vllm/vllm-openai@sha256:e4f88a835143cd22aee2397a26ec6bb80b3a4a6fe0c882bcbc63822904766089
VLLM_MODEL=nvidia/Qwen3.6-27B-NVFP4
VLLM_MODEL_REVISION=0893e1606ff3d5f97a441f405d5fc541a6bdf404
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=local
VLLM_GPU_MEMORY_UTILIZATION=0.45
VLLM_MAX_MODEL_LEN=262144
VLLM_START_TIMEOUT=1800
# DGX_VENV_DIR=.venv-dgx
# DGX_PYTHON_BIN=python3.12
# DGX_HF_CACHE=.local-models/huggingface
# DGX_VLLM_CACHE=.local-models/vllm

# ── Apple Silicon / oMLX ───────────────────────────────────────────────────
MLX_BASE_URL=http://127.0.0.1:8000/v1
MLX_API_KEY=local
MLX_MODEL=default
# OMLX_BASE_URL, OMLX_API_KEY, and OMLX_MODEL are accepted aliases.
# STRIDE_CONDA_ENV=langgraph-stride

# ── Optional hosted OpenAI compatibility ───────────────────────────────────
# OPENAI_API_KEY=sk-replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
